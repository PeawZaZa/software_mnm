[flake8]
# PEP 8 อนุญาตให้ทีมตกลงความยาวบรรทัดได้ถึง 99 ตัวอักษร
# (คอมเมนต์ภาษาไทยในโปรเจกต์นี้ยาวกว่าภาษาอังกฤษโดยเฉลี่ย)
max-line-length = 99
# app_v1.py คือ baseline v1.0.0 ที่อาจารย์ให้มา เก็บไว้ตามต้นฉบับเพื่อใช้เทียบ metrics
# จึงไม่แก้ไขและไม่นำมาสแกน
exclude = .git,__pycache__,.pytest_cache,build,dist,*.egg-info,.venv,venv,app_v1.py,การบ้าน
